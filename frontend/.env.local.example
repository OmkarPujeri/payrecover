# Where the browser reaches the FastAPI backend. Baked into the client bundle at
# build time, so it must be the address the *judge's browser* can reach — not a
# Docker service name.
#
# Local dev:  http://localhost:8000
# Compose:    http://localhost:8000   (the backend publishes 8000 to the host)
NEXT_PUBLIC_API_BASE=http://localhost:8000
