# Recharts 2.x is the one dependency the PRD names, and its published peer range
# has historically lagged behind each new React major. React 19 is not optional
# here (Next 15 requires it), so strict peer resolution can fail the install over
# a library we use for exactly one failure-mix pie.
#
# This flag makes `npm install` complete regardless of that peer range. It is a
# deliberate, narrow trade: the alternative is dropping the one charting library
# the brief actually asks for.
#
# If Recharts is ever removed, delete this file — nothing else needs it.
legacy-peer-deps=true
