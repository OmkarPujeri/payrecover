# ============================================================
# PayRecover — Environment Variables (example)
# Copy to `.env` and fill in. ALL keys are OPTIONAL:
# with no keys the backend runs in SIMULATION mode
# (mock Razorpay responses + mock LLM), so you can develop
# and demo the full pipeline without any credentials.
# ============================================================

# ---- Razorpay (Test Mode) — optional ----
# If BOTH key id + secret are set, real Razorpay API calls are made.
# If absent, the client returns realistic simulated responses.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Used to verify inbound webhook signatures. If absent, verification
# is skipped (a warning is logged) so simulator-injected events flow.
RAZORPAY_WEBHOOK_SECRET=

# ---- Groq AI — optional (used by agents, added in a later phase) ----
# If absent, the agent layer falls back to a deterministic mock.
GROQ_API_KEY=

# ---- PostgreSQL ----
# Local (non-Docker) default. Docker Compose overrides host to `db`.
DATABASE_URL=postgresql+asyncpg://payrecover:payrecover@localhost:5432/payrecover

# ---- App ----
APP_ENV=development
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# Force simulation mode even if Razorpay keys are present (optional).
FORCE_SIMULATION=false
